LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

ELEVEN_API_KEY=
ELEVEN_BASE_URL=
ELEVEN_VOICE_ID=
ELEVEN_MODEL_ID=

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

MODEL_NAME=
BASE_URL=
API_KEY=

# --- Qwen-Omni realtime (voice_agent_configurable.py) ---
# Ordered list of DashScope API keys, primary first, comma-separated. The agent
# uses the primary until it stops working, then fails over to the next key.
# Two failure modes are handled automatically:
#   - revoked/invalid key  -> HTTP 401/403/429 at the websocket handshake
#   - exhausted quota (1M tokens) -> handshake succeeds but the server drops the
#     socket immediately; detected as repeated connections dying right after connect
QWEN_API_KEYS=sk-key-primary,sk-key-backup1
# Single-key fallback: used only if QWEN_API_KEYS is unset/empty (no failover).
QWEN_API_KEY=
# Optional overrides (defaults shown — leave blank to keep them):
QWEN_BASE_URL=
QWEN_MODEL=
QWEN_VOICE=
# Optional: extra case-insensitive substrings that mark an in-band error as
# "rotate to the next key" (appended to the built-in defaults), comma-separated.
QWEN_KEY_ROTATE_MARKERS=
# Optional: tune the "dead key" detector (exhausted-quota path). Rotate after
# QWEN_KEY_DEAD_CONN_LIMIT connections that each die within QWEN_KEY_DEAD_CONN_SECONDS.
QWEN_KEY_DEAD_CONN_SECONDS=8
QWEN_KEY_DEAD_CONN_LIMIT=3